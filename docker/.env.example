# PostgreSQL credentials used by the database and the three database-backed services.
# Replace this sample password in production.
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=replace_this_database_password

# Shared HS256 signing key for auth and downstream services.
# Replace this sample key in production; JWT_SECRET must be at least 32 characters.
JWT_SECRET=replace_this_sample_jwt_secret_with_at_least_32_characters
JWT_EXPIRATION_MS=86400000

# Google Gemini credentials for AI triage. Leave the key empty to use service fallback behavior.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Critical event delivery over RabbitMQ, with REST fallback if publishing fails.
RABBITMQ_ENABLED=true
RABBITMQ_USER=resolveai
RABBITMQ_PASS=replace_this_rabbitmq_password

# Browser-facing URL embedded into the frontend build.
VITE_API_BASE_URL=http://localhost:8080

# Must match the URL used to open the frontend in the browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Low-memory machines (8 GB laptops): uncomment to reduce Java heap usage.
# JAVA_OPTS=-Xmx256m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError
