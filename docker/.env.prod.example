# Copy this file to docker/.env on the server, then replace every placeholder.
DOCKER_USERNAME=replace_with_docker_hub_username
IMAGE_TAG=latest

# DuckDNS hostname pointing to the EC2 Elastic IP, without a scheme.
API_DOMAIN=replace_with_yourname.duckdns.org
# Exact Vercel production origin; comma-separated origins are allowed, no trailing slash.
CORS_ALLOWED_ORIGINS=https://replace_with_your_vercel_project.vercel.app

POSTGRES_USER=replace_with_postgres_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password
JWT_SECRET=replace_with_a_secret_at_least_32_chars_generate_with_openssl_rand_base64_48
JWT_EXPIRATION_MS=86400000

# Set an actual Google Gemini key, or clear the placeholder for fallback triage.
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
RABBITMQ_ENABLED=true
RABBITMQ_USER=replace_with_rabbitmq_user
RABBITMQ_PASS=replace_with_a_strong_rabbitmq_password

BOOTSTRAP_ADMIN_NAME=replace_with_admin_display_name
BOOTSTRAP_ADMIN_EMAIL=replace_with_admin_email@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Optional JVM settings; default heap is 384 MB per Java service.
JAVA_OPTS=-Xmx384m -XX:+ExitOnOutOfMemoryError
